{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "jsx": "react-jsx"
  },
  "include": ["tokens/**/*.ts", "build/**/*.ts", "site/**/*.ts", "site/**/*.tsx", "primitives/**/*.ts", "primitives/**/*.tsx"]
}
